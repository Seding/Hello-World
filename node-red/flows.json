        "func": "// Entladung beenden: Sollwert 0, ESS zurueck auf Optimized (1)\nflow.set(\"NightDischargePower\", 0);\nflow.set(\"PowerL1SetPoint\", 0);\nnode.status({fill:\"grey\", shape:\"ring\", text:\"Nachtentladung beendet\"});\n// Ausgang 1: AcPowerSetpoint = 0 ; Ausgang 2: ESS-Mode 1\nreturn [ {payload: 0}, {payload: 1} ];",
